<form action="/payment_result">
  <label for="payment_apr">APR</label>
  <input id="payment_apr" type="text" placeholder="E.g. 5.42" name="apr">
  <label for="payment_year">Number of years</label>
  <input id="payment_year" type="text" placeholder="How many years to repay?" name="years">
  <label for="payment_princ">Principal</label>
  <input id="payment_princ" type="text" placeholder="How much principal?" name="principal">
  <button type="submit">Calculate monthly payment</button>
</form>
