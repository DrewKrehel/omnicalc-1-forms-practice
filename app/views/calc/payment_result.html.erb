<h1>Payment Results</h1>

<dl>
  <dt>
    APR
  </dt>
  <dd>
    <%= @apr_input.to_fs(:percentage, {:precision => 4}) %>
  </dd>

  <dt>
    Number of years
  </dt>
  <dd>
    <%= @years %>
  </dd>

  <dt>
    Principal
  </dt>
  <dd>
    $<%= @principal %>
  </dd>

  <dt>
    Payment
  </dt>
  <dd>
    <%= @payment.to_fs(:currency, { :precision => 2 }) %>
  </dd>
</dl>

<a href="/payment">
  Calculate another payment
</a>
